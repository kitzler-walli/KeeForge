    "Set a passcode on this Apple Watch to keep NextPass entries on it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie auf dieser Apple Watch einen Code fest, um NextPass-Einträge darauf zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un código en este Apple Watch para guardar en él las entradas de NextPass."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un code sur cette Apple Watch pour y conserver les entrées NextPass."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NextPass のエントリをこの Apple Watch に保存するには、パスコードを設定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在这块 Apple Watch 上设置密码，以便在其上保存 NextPass 条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在這支 Apple Watch 上設定密碼，以便在其中保存 NextPass 項目。"
          }
        }
      }
    },
