    },
    "On your iPhone, tag entries “Apple Watch” in NextPass and open the database. They stay available here without your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versehen Sie auf Ihrem iPhone Einträge in NextPass mit dem Tag „Apple Watch“ und öffnen Sie die Datenbank. Die Einträge bleiben hier auch ohne Ihr iPhone verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu iPhone, añade la etiqueta “Apple Watch” a las entradas en NextPass y abre la base de datos. Seguirán disponibles aquí sin tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre iPhone, ajoutez le tag « Apple Watch » à des entrées dans NextPass, puis ouvrez la base de données. Elles restent disponibles ici sans votre iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の NextPass でエントリに「Apple Watch」タグを付け、データベースを開いてください。iPhone がなくても、ここで引き続き利用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上的 NextPass 中为条目添加“Apple Watch”标签，然后打开数据库。即使没有 iPhone，这些条目也会保留在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上的 NextPass 中為項目加上「Apple Watch」標籤，然後打開資料庫。即使沒有 iPhone，這些項目也會保留在這裡。"
          }
        }
      }
    },
